{
  "name": "startup-tasks-automation",
  "version": "2.0.2",
  "description": "Run a list of commands with delays when your computer starts, for example open Chrome, Slack or a project in VS Code.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.js && tsc",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "npm-publish": "npm run lint && npm run build && npm publish"
  },
  "author": "David Marjanidze",
  "license": "ISC",
  "homepage": "https://github.com/davidmarjanidze/startup-tasks-automation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidmarjanidze/startup-tasks-automation.git"
  },
  "bugs": {
    "url": "https://github.com/davidmarjanidze/startup-tasks-automation/issues"
  },
  "keywords": [
    "startup",
    "startup tasks",
    "automation",
    "boot",
    "autostart"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
